# Optional OpenAI-compatible model for evidence-grounded explanations.
# Without these, the complete planning and approval workflow uses deterministic insights.
JALASETU_LLM_BASE_URL=
JALASETU_LLM_API_KEY=
JALASETU_LLM_MODEL=
# SQLite path defaults to data/jalasetu.sqlite3
# JALASETU_DB=


# Public evidence collectors work without these keys.
# LLM panel: use Connections in the local UI, or export the variables above.
# Tavily discovery is optional and uses a separate credential.
TAVILY_API_KEY=
# Standard OpenAI variables are also accepted for the research panel.
OPENAI_API_KEY=
OPENAI_MODEL=

# Jev authority routing uses a separate TypeSafe credential.
TYPESAFE_API_KEY=
JALASETU_JEV_MODEL=jev-latest

# Hosted pilot only. Never put actual management credentials in this tracked example.
JALASETU_DEPLOYED=false
JALASETU_ACCESS_USER=management
JALASETU_ACCESS_PASSWORD=
WEB_CONCURRENCY=1

# Render free sandbox: temporary cloud records; local mode remains unchanged.
# JALASETU_STORAGE_MODE=ephemeral

# Hosted provider calls use visitor session keys from Connections, not these owner variables.
# Provider environment variables above apply only to the unscoped local development workspace.
